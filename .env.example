# SignalForge configuration - copy to .env and fill in ONLY what you need. Never commit .env.
#
# The default mode needs nothing from this file: `signalforge investigate INC-2026-0101` runs the
# SCRIPTED DEMONSTRATION provider with no LLM and no network.
#
# Live providers call PAID APIs. A Claude Max / Pro subscription is NOT an Anthropic API key, and a
# ChatGPT Plus subscription is NOT an OpenAI API key. API keys come from the vendors' developer consoles.

# scripted | replay | anthropic | openai            (default: scripted)
SIGNALFORGE_PROVIDER=scripted

# --- Anthropic (pip install "signalforge[anthropic]") ---
# ANTHROPIC_API_KEY=<your Anthropic Console API key>
# The Claude model id to use; check the current model list in the Anthropic docs before setting.
# SIGNALFORGE_ANTHROPIC_MODEL=<model id>

# --- OpenAI (pip install "signalforge[openai]") ---
# OPENAI_API_KEY=<your OpenAI platform API key>
# The OpenAI model id to use; check the current model list in the OpenAI docs before setting.
# SIGNALFORGE_OPENAI_MODEL=<model id>

# --- Optional live-provider tuning ---
# SIGNALFORGE_MAX_OUTPUT_TOKENS=8192
# SIGNALFORGE_PROVIDER_TIMEOUT=120
# SIGNALFORGE_EFFORT=            # anthropic: low|medium|high|xhigh|max   openai: low|medium|high
